{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@vault/common/(.*)$": "<rootDir>/../common/dist/$1",
    "^@vault/common$": "<rootDir>/../common/dist"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1
}
