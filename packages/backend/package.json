{
  "name": "@vault/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typeorm": "TS_NODE_PROJECT=./tsconfig.json ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "yarn typeorm migration:generate",
    "migration:create": "yarn typeorm migration:create",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:show": "yarn typeorm migration:show",
    "schema:drift": "ts-node src/database/schema-drift.ts",
    "read-check": "ts-node src/database/read-check.ts",
    "auth-check": "ts-node src/globals/auth-check.ts",
    "test": "jest",
    "test:int": "jest --config test/jest-integration.json --runInBand",
    "test:all": "yarn test && yarn test:int",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-session": "^1.19.0",
    "music-metadata": "^11.15.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "socks": "^2.8.10",
    "typeorm": "^1.0.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-oauth2": "^1.8.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@vault/common": "*"
  }
}
