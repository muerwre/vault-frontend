{
  "name": "@vault/media-fetcher",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf ./dist && ncc build src/main.ts --out dist --source-map",
    "dev": "ts-node src/main.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@vault/common": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.4.1",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
