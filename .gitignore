# dependencies & build output (matched at any depth for workspaces)
node_modules
npm-debug.log
.idea
dist
build
.next
.vscode
.history
.DS_Store
*.tsbuildinfo

# env — .env.local provides the real configuration and is never committed.
# .env.example is the committed template.
.env
.env.local
.env.*.local
!.env.example

# intermediate migration spec / reference material (dump, example repos)
/examples

# merged backend coverage (yarn backend:coverage)
coverage/
# Local notes. The four README.md files are already tracked, and a rule
# never un-tracks a file, so they stay in the repo.
*.md
