# Template only — copy to `.env.local` and fill in. Never put real secrets here;
# `.env.local` provides the environment and is gitignored.
#
# Load order (packages/backend/src/config/env.ts):
#   development: ../../.env.local  then  ../../.env   — first match wins
#   production:  ./.env

PORT=8000
DEBUG=false

# ---------------------------------------------------------------------------
# database
# ---------------------------------------------------------------------------

# Keep the `mariadb://` scheme: it selects the driver type, which changes how
# column defaults are read out of information_schema. `mysql://` makes every
# nullable column look permanently drifted.
# Defaults to ci/compose.yml's container.
DATABASE_URL=mariadb://root:password@localhost:3306/adonis
DATABASE_DEBUG=false

# ---------------------------------------------------------------------------
# api
# ---------------------------------------------------------------------------

API_DEBUG=false
API_PUBLIC_URL=

# Signs and verifies API tokens. Must match whatever issued the tokens currently
# in circulation — they carry no `exp`, so a mismatch invalidates all of them.
JWT_SECRET=

# ---------------------------------------------------------------------------
# frontend
# ---------------------------------------------------------------------------

FRONTEND_RESET_URL=/restore/
FRONTEND_PUBLIC_HOST=

# Point the frontend at the backend to run the real app against it.
# NEXT_PUBLIC_API_HOST=http://localhost:8000/api/

# ---------------------------------------------------------------------------
# google
# ---------------------------------------------------------------------------

# Used by GET /meta/youtube to resolve titles missing from the embed cache.
# Optional: without it, cached embeds are still served and only new videos fail.
GOOGLE_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------------------------------------------------------------------------
# mail
# ---------------------------------------------------------------------------
# Optional: with no host configured, mail is skipped rather than failing.

SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# uploads
# ---------------------------------------------------------------------------

UPLOADS_PATH=
UPLOADS_MAX_SIZE_MB=200
UPLOADS_OUTPUT_WEBP=true

# ---------------------------------------------------------------------------
# vkontakte
# ---------------------------------------------------------------------------
# Optional. Enabling the notifier posts to a live group and album.

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_CALLBACK_URL=

NOTIFICATIONS_VK_ENABLED=false
NOTIFICATIONS_VK_API_KEY=
NOTIFICATIONS_VK_GROUP_ID=
NOTIFICATIONS_VK_APP_ID=
NOTIFICATIONS_VK_ALBUM_ID=
NOTIFICATIONS_VK_COOLDOWN_MINS=5
NOTIFICATIONS_VK_PURGE_AFTER_DAYS=7
NOTIFICATIONS_VK_URL_PREFIX=

# ---------------------------------------------------------------------------
# telegram
# ---------------------------------------------------------------------------
# Optional. A live token sends real messages; prefer a test bot.

TELEGRAM_TOKEN=
