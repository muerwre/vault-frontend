# Template only — copy to `.env.local` and fill in. Never put real secrets here;
# `.env.local` is the file that provides the environment and is gitignored.
#
# Load order (packages/backend/src/config/env.ts, mirroring the orchid example):
#   development: ../../.env.local  then  ../../.env   — first match wins
#   production:  ./.env

# ---------------------------------------------------------------------------
# backend
# ---------------------------------------------------------------------------

# Connection URI. Keep the `mariadb://` scheme — it selects TypeORM's MariaDB
# driver, which reads column defaults out of information_schema differently from
# the mysql driver; `mysql://` makes every nullable column look permanently
# drifted. Defaults to ci/compose.yml's container.
DATABASE_URL=mariadb://root:password@localhost:3306/vault

# HS256 secret for the API tokens. **Must match the Go backend's JWT_SECRET** in
# any environment that shares its users — existing tokens have no `exp` and never
# expire, so a different secret logs every user out at cutover.
JWT_SECRET=

PORT=7777

# Google API key for the YouTube Data API v3 (Go's `Google.ApiKey`). Used by
# GET /meta/youtube to resolve titles of videos not yet in the `embed` cache.
#
# Optional: without it the endpoint still serves cached embeds (~1900 videos are
# already cached), and only newly-embedded videos fail to resolve a title.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# frontend
# ---------------------------------------------------------------------------

# Point this at the NestJS instance to run the real app against it.
# NEXT_PUBLIC_API_HOST=http://localhost:7777/api/
