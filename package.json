{
  "name": "vault",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "build": "yarn lerna run build",
    "dev": "lerna run dev --parallel",
    "typecheck": "yarn lerna run typecheck",
    "lint": "yarn lerna run lint --no-bail",
    "frontend:dev": "yarn workspace @vault/frontend run dev",
    "frontend:build": "yarn workspace @vault/frontend run build",
    "backend:dev": "yarn workspace @vault/backend run dev",
    "backend:build": "yarn workspace @vault/backend run build",
    "common:build": "yarn workspace @vault/common run build"
  },
  "devDependencies": {
    "husky": "^7.0.4",
    "lerna": "^8.1.8",
    "lint-staged": "^12.1.6",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "packages/frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-error-on-unmatched-pattern"
    ]
  }
}
